<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build/Package.props" />
  <PropertyGroup>
    <TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
    <Description>C# 7.3-friendly Task-based facade for BrowserDock, including .NET Framework 4.8.1.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BrowserDock/BrowserDock.csproj" />
    <InternalsVisibleTo Include="BrowserDock.Tests" />
    <InternalsVisibleTo Include="BrowserDock.FrameworkTests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
