<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
    <Version>0.2.0</Version>
    <Description>C# 7.3-friendly Task-based facade for UcDotNet, including .NET Framework 4.8.1.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UcDotNet/UcDotNet.csproj" />
    <InternalsVisibleTo Include="UcDotNet.Tests" />
    <InternalsVisibleTo Include="UcDotNet.FrameworkTests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
