<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build/Package.props" />
  <PropertyGroup>
    <TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
    <Description>Independent Chrome lifecycle and guarded Selenium attachments. Unofficial compatibility library.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Selenium.WebDriver" Version="[4.44.0]" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <InternalsVisibleTo Include="BrowserDock.Tests" />
    <InternalsVisibleTo Include="BrowserDock.FrameworkTests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Using Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
