<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ReferencePages.cs" Link="Fixtures/ReferencePages.cs" />
    <None Include="../seleniumbase-reference/scenarios.json" Link="scenarios.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/BrowserDock/BrowserDock.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NUnit" Version="4.6.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
  <Target Name="BuildFixtureHost" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../BrowserDock.FixtureHost/BrowserDock.FixtureHost.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier;PlatformTarget" />
  </Target>
</Project>
