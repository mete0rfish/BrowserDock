<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net481'">x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/FailureEvidence.cs" Link="Fixtures/FailureEvidence.cs" />
    <Compile Include="../Shared/HighLevelInteractionReference.cs" Link="Fixtures/HighLevelInteractionReference.cs" />
    <Compile Include="../Shared/ReferenceEndpointReadiness.cs" Link="Fixtures/ReferenceEndpointReadiness.cs" />
    <Compile Include="../Shared/ReferenceEndpointReadinessTests.cs" Link="ReferenceEndpointReadinessTests.cs" />
    <Compile Include="../Shared/HighLevelReferenceTests.cs" Link="HighLevelReferenceTests.cs" />
    <Compile Include="../Shared/CommandDeadlineTests.cs" Link="CommandDeadlineTests.cs" />
    <Compile Include="../Shared/CleanupThreadEvidence.cs" Link="Fixtures/CleanupThreadEvidence.cs" />
    <Compile Include="../Shared/CdpCleanupRaceTests.cs" Link="CdpCleanupRaceTests.cs" />
    <Compile Include="../Shared/ElementWaitTests.cs" Link="ElementWaitTests.cs" />
    <Compile Include="../Shared/TextWaitTests.cs" Link="TextWaitTests.cs" />
    <Compile Include="../Shared/ElementClickTests.cs" Link="ElementClickTests.cs" />
    <Compile Include="../Shared/ElementInputTests.cs" Link="ElementInputTests.cs" />
    <Compile Include="../Shared/ScriptErrorTests.cs" Link="ScriptErrorTests.cs" />
    <Compile Include="../Shared/ScriptErrorBrowserTests.cs" Link="ScriptErrorBrowserTests.cs" />
    <Compile Include="../Shared/ElementInputBrowserTests.cs" Link="ElementInputBrowserTests.cs" />
    <Compile Include="../Shared/ElementClickBrowserTests.cs" Link="ElementClickBrowserTests.cs" />
    <Compile Include="../Shared/ElementWaitBrowserTests.cs" Link="ElementWaitBrowserTests.cs" />
    <Compile Include="../Shared/StartupSnapshotTests.cs" Link="StartupSnapshotTests.cs" />
    <Compile Include="../Shared/OptionsCaptureTests.cs" Link="OptionsCaptureTests.cs" />
    <Compile Include="../Shared/NavigationOptionsTests.cs" Link="NavigationOptionsTests.cs" />
    <Compile Include="../Shared/NavigationDiagnosticsTests.cs" Link="NavigationDiagnosticsTests.cs" />
    <Compile Include="../Shared/UcWorkflowTests.cs" Link="UcWorkflowTests.cs" />
    <Compile Include="../Shared/UcLaunchProfileTests.cs" Link="UcLaunchProfileTests.cs" />
    <Compile Include="../Shared/UcScriptRegistrationTests.cs" Link="UcScriptRegistrationTests.cs" />
    <Compile Include="../Shared/UcLaunchProfileBrowserTests.cs" Link="UcLaunchProfileBrowserTests.cs" />
    <Compile Include="../Shared/UcBrowserTests.cs" Link="UcBrowserTests.cs" />
    <ProjectReference Include="../../src/BrowserDock.Legacy/BrowserDock.Legacy.csproj" />
    <None Include="../seleniumbase-reference/scenarios.json" Link="scenarios.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <Using Include="System.Net.Http" Condition="'$(TargetFramework)' == 'net481'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <Target Name="BuildFixtureHost" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../BrowserDock.FixtureHost/BrowserDock.FixtureHost.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier;PlatformTarget" />
    <MSBuild Projects="../BrowserDock.CleanupInvestigation/BrowserDock.CleanupInvestigation.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier;PlatformTarget" Condition="'$(TargetFramework)' == 'net481'" />
  </Target>
</Project>
